{
  "name": "blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:tail": "wrangler tail",
    "cf:whoami": "wrangler whoami",
    "d1:create": "wrangler d1 create cloudblog-d1",
    "d1:list": "wrangler d1 list",
    "d1:info": "wrangler d1 info cloudblog-d1",
    "d1:backup:local": "wrangler d1 export cloudblog-d1 --local --output=./backups/backup-local.sql",
    "d1:backup:remote": "wrangler d1 export cloudblog-d1 --remote --output=./backups/backup-remote.sql",
    "r2:create": "wrangler r2 bucket create cloudblog-media",
    "r2:list": "wrangler r2 bucket list",
    "kv:create": "wrangler kv namespace create CLOUDBLOG_KV",
    "kv:list": "wrangler kv namespace list",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cloudblog-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply cloudblog-d1 --remote",
    "db:seed:generate": "bun run scripts/seed.ts",
    "db:seed": "wrangler d1 execute cloudblog-d1 --local --file=./scripts/seed.sql",
    "db:seed:local": "wrangler d1 execute cloudblog-d1 --local --file=./scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute cloudblog-d1 --remote --file=./scripts/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@opennextjs/cloudflare": "^1.20.7",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "highlight.js": "^11.12.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "3.8.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.144.0"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
