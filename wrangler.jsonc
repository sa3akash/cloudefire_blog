{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudblog",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudblog-d1",
      "database_id": "cb964ba3-6fec-451a-b08d-7e739e34d158",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "SITE_URL": "https://blogbd.eu.cc",
    "SITE_NAME": "CloudBlog"
  },
  "routes": [
    {
      "pattern": "blogbd.eu.cc",
      "custom_domain": true
    }
  ]
}
