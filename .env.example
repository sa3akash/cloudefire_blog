# CloudBlog Universal Platform Environment Configuration

# Public Site Configuration
NEXT_PUBLIC_SITE_URL=https://blogbd.eu.cc
NEXT_PUBLIC_SITE_NAME="CloudBlog"
NEXT_PUBLIC_SITE_DESCRIPTION="A high-performance editorial publication platform engineered for the modern web."

# Search Engine & Webmaster Verification
# Google Search Console (get your meta content code from Google Search Console > URL prefix > HTML tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
# Bing Webmaster Tools
NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-site-verification-token
# Yandex Webmaster (optional)
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
# Facebook Domain Verification (from Meta Business Manager > Brand Safety > Domains)
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=your-meta-domain-verification-token

# Marketing & Analytics Pixels
# Meta / Facebook Pixel ID (from Meta Events Manager)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Google Tag Manager Container ID (optional, e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Security & Session Authentication
SESSION_SECRET=super-secret-random-32-character-encryption-key-for-cookies
ADMIN_SETUP_SECRET=change-this-to-a-secure-random-token-for-initial-setup
ADMIN_INITIAL_EMAIL=admin@cloudblog.local
ADMIN_INITIAL_PASSWORD=CloudBlogSecurePassword2026!

# --- Deployment Target 1: Cloudflare Free Tier (Workers / Pages + D1 + R2) ---
# Wrangler / Cloudflare Account
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# D1 Database (SQLite at edge)
D1_DATABASE_NAME=cloudblog-d1
D1_DATABASE_ID=your-d1-database-id

# R2 Storage (Zero egress object storage)
R2_BUCKET_NAME=cloudblog-media
# Optional public CDN domain for R2
# NEXT_PUBLIC_R2_URL=https://media.yourdomain.com

# --- Deployment Target 2: Alternative Cloud / Vercel / Standard PostgreSQL ---
# If deploying to Vercel/Node with Neon or Supabase PostgreSQL, specify connection string:
# DATABASE_URL=postgresql://user:password@ep-sample.neon.tech/cloudblog?sslmode=require
# S3_ACCESS_KEY_ID=your-s3-access-key-for-aws-or-r2
# S3_SECRET_ACCESS_KEY=your-s3-secret-key
